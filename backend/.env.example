# Copy to .env and fill in real values. Never commit the filled-in file.
# On a host (Render, Railway, Fly) set these in the dashboard instead, so
# secrets never enter the repository at all.

# Mongo connection string, including the database name
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>"

# Signs auth tokens. Any long random string; rotating it logs everyone out.
JWT_SECRET="<long-random-string>"

# The single admin account the panel authenticates against
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<a-real-password-not-a-digit-sequence>"

# Cloudinary, for product image uploads
CLOUDINARY_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_SECRET_KEY="<api-secret>"

# Stripe, for card checkout
STRIPE_SECRET_KEY="sk_test_..."

# Optional. Defaults to 4000 when unset.
PORT=4000
